{
  "name": "game-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose up",
    "down": "docker compose down",
    "start": "tsx src/server.ts",
    "test": "docker compose --profile test run --rm test",
    "test:inner": "tsx --test test/*.test.ts",
    "install:host": "docker compose --profile install-host run --rm install-host"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.5",
    "onnxruntime-node": "^1.21.0",
    "ts-core": "file:../ts-core"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
