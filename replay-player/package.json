{
  "name": "replay-player",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "docker compose --profile test run --rm test",
    "test:inner": "tsx --test test/*.test.ts",
    "install:host": "docker compose --profile install-host run --rm install-host"
  },
  "dependencies": {
    "ts-core": "file:../ts-core"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
