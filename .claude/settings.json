{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps*)",
      "Bash(docker compose config*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose config*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(tsx *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(docker run -v*)",
      "PowerShell(node *)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(tsx *)",
      "PowerShell(python *)",
      "PowerShell(python3 *)",
      "PowerShell(pip *)",
      "PowerShell(pip3 *)",
      "PowerShell(docker run -v*)"
    ]
  }
}
